rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Documents / Credentials Ledger
    // Read is public so anyone with a QR code or verification link can verify cryptographic integrity
    // Create and update permitted so verified credentials and versioning can be anchored across sessions
    match /documents/{documentId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false; // Immutable ledger
    }

    // Donations Ledger
    // Public transparency ledger for donation traceability and expense verification
    match /donations/{donationId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Audit Trail Events
    match /audit_events/{eventId} {
      allow read: if true;
      allow create: if true; // Allows public verifiers to log verification trail
      allow update, delete: if false; // Immutable audit events
    }
  }
}
